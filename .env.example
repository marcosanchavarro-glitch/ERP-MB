# Nunca pegar credenciales reales en este archivo.
NODE_ENV=development
APP_TIMEZONE=America/Argentina/Buenos_Aires
PORT=5173
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=
MIGRATION_DATABASE_URL=
SESSION_SECRET=
SESSION_TTL_MS=28800000
LOGIN_LIMIT=20
LOGIN_WINDOW_MS=900000
API_LIMIT=300
# En producción: HTTPS y solo IP/CIDR del proxy conocido (no "true").
TRUST_PROXY=
DB_SSL=false
DB_CA_FILE=
# Identidad pública de la instalación. No contiene secretos.
APP_ENV=local
APP_NAME=HALO
ORGANIZATION_NAME=Manantial de Bendiciones
APP_LOGO_PATH=
APP_FAVICON_PATH=/src/favicon.svg
# APP_URL es alias de APP_ORIGIN; en Render se usa RENDER_EXTERNAL_URL si ambos faltan.
# Exclusivos del bootstrap DEMO: valores de 48 bytes aleatorios en hexadecimal.
RUNTIME_DB_PASSWORD=
DEMO_BOOTSTRAP_SECRET=
ALLOW_DEMO_SEED=false
# TEST_DATABASE_URL debe apuntar a una base exclusiva de pruebas.
TEST_DATABASE_URL=

# Backup lógico: requiere clientes oficiales PostgreSQL.
BACKUP_DATABASE_URL=
PG_DUMP_BIN=
# Geocodificación opcional; clave privada, solo backend. Sin clave, ubicación manual.
GEOAPIFY_API_KEY=
# Tope local conservador, máximo 3000/día. No habilita facturación.
GEOCODING_DAILY_LIMIT=250
# Centro regional de referencia, NO ubicación exacta de una sede.
TERRITORY_REFERENCE_LATITUDE=-34.8
TERRITORY_REFERENCE_LONGITUDE=-58.6
TERRITORY_REFERENCE_ZOOM=10
TERRITORY_REFERENCE_LABEL=Buenos Aires · vista regional de referencia
# Geoapify cartografía: clave PUBLICA separada, restringida por dominios/referrer.
# Nunca reutilizar GEOAPIFY_API_KEY (geocodificación privada).
GEOAPIFY_MAPS_BROWSER_KEY=
# Estilos vectoriales claros permitidos: osm-bright-smooth, osm-bright, osm-liberty, positron.
# Dark usa dark-matter. Sin clave: raster OSM identificado; no Google Maps.
GEOAPIFY_MAP_STYLE=osm-bright
